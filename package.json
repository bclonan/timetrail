{
  "name": "timetrail",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.8.0",
  "scripts": {
    "prepare:runtime": "node scripts/prepare-frametrail.mjs",
    "dev": "pnpm prepare:runtime && vite --host 127.0.0.1",
    "build": "pnpm prepare:runtime && vue-tsc --noEmit && vite build && node scripts/build-offline.mjs",
    "preview": "vite preview --host 127.0.0.1",
    "typecheck": "vue-tsc --noEmit",
    "lint": "eslint src tests scripts --max-warnings 0",
    "test": "vitest run",
    "playwright": "playwright",
    "format": "prettier --write src tests scripts *.ts *.js *.json *.yaml docs README.md AGENTS.md"
  },
  "dependencies": {
    "vue": "^3.5.18",
    "vue-router": "^4.5.1",
    "pinia": "^3.0.3",
    "idb": "^8.0.3",
    "zod": "^4.1.5",
    "fflate": "^0.8.2",
    "fuse.js": "^7.1.0",
    "ulid": "^3.0.1",
    "dompurify": "^3.4.17",
    "lucide-vue-next": "^0.468.0",
    "mediabunny": "1.55.5"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^6.0.1",
    "vite": "^7.1.4",
    "typescript": "~5.9.2",
    "vue-tsc": "^3.0.6",
    "vitest": "^3.2.4",
    "@vue/test-utils": "^2.4.6",
    "@playwright/test": "^1.55.0",
    "fake-indexeddb": "^6.1.0",
    "jsdom": "^26.1.0",
    "eslint": "^9.34.0",
    "@eslint/js": "^9.34.0",
    "typescript-eslint": "^8.41.0",
    "eslint-plugin-vue": "^10.4.0",
    "globals": "^16.3.0",
    "@types/node": "^22.18.0",
    "webmcp-types": "latest",
    "esbuild": "^0.28.2",
    "prettier": "^3.6.2"
  }
}
